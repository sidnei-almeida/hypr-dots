#!/usr/bin/env bash
# Lista todos os atalhos ativos, lidos direto do Hyprland.
# Como a fonte é o `hyprctl binds`, a lista nunca fica desatualizada.
# Atalho: SUPER + K

set -euo pipefail

pkill -x fuzzel 2>/dev/null && exit 0

hyprctl binds -j | jq -r '
  # Só os binds que têm descrição — os internos ficam de fora
  .[] | select(.has_description)

  # Reconstrói o nome da combinação a partir da máscara de modificadores
  | (.modmask as $m
     | [ (if ($m / 64  | floor) % 2 == 1 then "SUPER" else empty end)
       , (if ($m / 8   | floor) % 2 == 1 then "ALT"   else empty end)
       , (if ($m / 4   | floor) % 2 == 1 then "CTRL"  else empty end)
       , (if ($m       | floor) % 2 == 1 then "SHIFT" else empty end)
       ]) as $mods

  | (if .key != "" then .key else "?" end) as $key
  | "\(($mods + [$key]) | join(" + "))\t\(.description)"
' | sort | awk -F'\t' '{ printf "%-34s  %s\n", $1, $2 }' |
  fuzzel --dmenu --prompt "   " --placeholder "Buscar atalho..." \
    --lines 20 --width 72 >/dev/null || true
