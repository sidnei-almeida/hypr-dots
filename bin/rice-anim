#!/usr/bin/env bash
# ┌──────────────────────────────────────────────────────────────┐
# │  Ritmo e estilo das animações do Hyprland.                    │
# └──────────────────────────────────────────────────────────────┘
#
#   rice-anim                    mostra o estado atual
#   rice-anim ritmo 0.8          20% mais RÁPIDO (a família inteira)
#   rice-anim quique 0.85        menos overshoot
#   rice-anim estilo genio       troca a FORMA do movimento
#   rice-anim padrao             volta para 1.0 / 0.70 / mola
#
# ── POR QUE ISTO EXISTE ─────────────────────────────────────────
#
# As animações são molas, e mola é definida por rigidez e atrito — dois
# números que dependem AMBOS do período. Ajustar "está lento demais" à
# mão significava recalcular os dois juntos para cada uma das três molas;
# mexer só num deles descasa a mola e o movimento deixa de fechar.
#
# Aqui se ajusta o que se PENSA (o ritmo, o quique, a forma) e a conta
# fica no looknfeel.lua, que deriva rigidez e atrito de T e ζ.
#
# ── OS DOIS EIXOS SÃO INDEPENDENTES ─────────────────────────────
#
#   ritmo  → o TEMPO. Multiplica todos os períodos de uma vez. É um
#            multiplicador, e não valores soltos por animação, porque a
#            família tem de continuar sendo uma família: acelerar a
#            janela e esquecer a barra é o que produz um conjunto que
#            parece remendo.
#
#   estilo → a FORMA. Dá para achar o `genio` bonito e ainda assim
#            querer tudo 20% mais rápido, sem um ajuste desfazer o outro.

set -uo pipefail

ARQ="$HOME/.config/hypr/anim-escolha.lua"
ESTILOS=(mola cortina deslize genio)

verde=$'\e[32m'; verm=$'\e[31m'; ama=$'\e[33m'; dim=$'\e[2m'; zero=$'\e[0m'

# Lê um campo do arquivo atual; devolve o padrão se não houver arquivo.
ler() {
    local campo=$1 padrao=$2 v=""
    [[ -f $ARQ ]] && v=$(sed -n "s/^ *$campo *= *\"\{0,1\}\([^\",]*\)\"\{0,1\},.*/\1/p" "$ARQ" | head -1)
    echo "${v:-$padrao}"
}

escrever() {
    local ritmo=$1 quique=$2 estilo=$3
    cat > "$ARQ" <<EOF
-- Gerado por rice-anim. Não edite à mão: será sobrescrito.
--
-- ritmo  multiplica o período de TODAS as animações.
--        0.8 = 20% mais rápido · 1.0 = padrão · 1.3 = mais calmo
-- quique é o ζ da mola: 1.0 não passa do alvo, 0.70 passa ~4.6% e volta.
-- estilo é a forma: ${ESTILOS[*]}
--
-- A conta que transforma isto em rigidez e atrito está no looknfeel.lua.
return {
  ritmo  = $ritmo,
  quique = $quique,
  estilo = "$estilo",
}
EOF
    # Recarregar é obrigatório: o Hyprland lê o config uma vez, e as
    # curvas são registradas na carga. Sem isto nada do que está aí
    # acima chega ao compositor.
    if hyprctl reload >/dev/null 2>&1; then
        local erros; erros=$(hyprctl configerrors 2>/dev/null)
        if [[ -n ${erros//[[:space:]]/} ]]; then
            printf '%s  ✗%s o Hyprland recusou o config:\n%s\n' "$verm" "$zero" "$erros"
            return 1
        fi
    fi
    estado
}

estado() {
    local r q e
    r=$(ler ritmo 1.0); q=$(ler quique 0.70); e=$(ler estilo mola)
    echo
    printf '  ritmo   %s%s%s\n' "$verde" "$r" "$zero"
    printf '  quique  %s%s%s%s   (ζ da mola)%s\n' "$verde" "$q" "$zero" "$dim" "$zero"
    printf '  estilo  %s%s%s\n' "$verde" "$e" "$zero"
    echo
    # O período efetivo é o que se sente; o multiplicador sozinho não diz
    # nada a quem está julgando "isso está lento".
    awk -v r="$r" 'BEGIN {
        printf "  %speríodos com este ritmo: janela %.0fms · barra %.0fms · área %.0fms%s\n",
               "\033[2m", 420*r, 300*r, 360*r, "\033[0m"
    }'
    echo
}

uso() {
    cat <<FIM

  rice-anim                    estado atual
  rice-anim ritmo 0.8          20% mais rápido (a família inteira)
  rice-anim quique 0.85        menos overshoot (1.0 = nenhum)
  rice-anim estilo <nome>      ${ESTILOS[*]}
  rice-anim padrao             volta para 1.0 / 0.70 / mola

  Estilos:
    mola      janela nasce a 92% e assenta; área desliza 15% e esvanece
    cortina   janela desce do topo — combina com a barra em cima
    deslize   tudo horizontal, sem escala; o mais sóbrio
    genio     o "genie" do GNOME; o mais chamativo, e o que cansa antes

FIM
}

num_ok() { awk -v v="$1" -v lo="$2" -v hi="$3" 'BEGIN { exit !(v+0==v && v>=lo && v<=hi) }' 2>/dev/null; }

case "${1:-}" in
    "")     estado ;;
    padrao) escrever 1.0 0.70 mola ;;
    ritmo)
        v=${2:-}
        # Fora de 0.4..2.0 não é ajuste, é engano de digitação: 0.1 some
        # com a animação e 10 tranca a tela por segundos.
        num_ok "$v" 0.4 2.0 || { printf '%s  ✗%s ritmo tem de ser um número entre 0.4 e 2.0\n' "$verm" "$zero"; exit 1; }
        escrever "$v" "$(ler quique 0.70)" "$(ler estilo mola)" ;;
    quique)
        v=${2:-}
        # Abaixo de 0.5 vira gelatina; acima de 1.0 a mola nem chega ao
        # alvo no tempo que se espera dela.
        num_ok "$v" 0.5 1.0 || { printf '%s  ✗%s quique tem de ser um número entre 0.5 e 1.0\n' "$verm" "$zero"; exit 1; }
        escrever "$(ler ritmo 1.0)" "$v" "$(ler estilo mola)" ;;
    estilo)
        v=${2:-}
        [[ " ${ESTILOS[*]} " == *" $v "* ]] || {
            printf '%s  ✗%s estilo desconhecido: %s\n' "$verm" "$zero" "${v:-(vazio)}"
            printf '%s  ·%s conhecidos: %s\n' "$ama" "$zero" "${ESTILOS[*]}"; exit 1; }
        escrever "$(ler ritmo 1.0)" "$(ler quique 0.70)" "$v" ;;
    *)      uso; exit 1 ;;
esac
